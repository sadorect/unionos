APP_NAME=UnionOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=unionos
DB_USERNAME=unionos
DB_PASSWORD=unionos_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Production: set these to secure values ---
# SESSION_ENCRYPT=true          # encrypts session data at rest in the DB
# SESSION_SECURE_COOKIE=true    # requires HTTPS — must be true in production
# SESSION_SAME_SITE=strict      # prevents cross-site session leakage
# --- Local dev overrides (permissive for HTTP/localhost) ---
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

UNIONOS_INVITE_TTL_HOURS=72
UNIONOS_CAPTCHA_MIN=1
UNIONOS_CAPTCHA_MAX=9
UNIONOS_AUTH_RATE_LIMIT=5

# Required in production — generate with: openssl rand -hex 32
# Used to authenticate requests to /health/unionos and /metrics/unionos
UNIONOS_SYSTEM_TOKEN=
